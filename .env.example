# Public Supabase project values (safe for the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL used to build auth email redirect links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret. Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared HMAC secret used only to verify normalized SaaS payment webhooks.
SAAS_WEBHOOK_SECRET=replace-with-a-random-secret

# Server-only authorization for the asynchronous notification worker endpoint.
NOTIFICATION_WORKER_SECRET=replace-with-a-random-secret

# Keep disabled until disposable PostgreSQL regressions and staging smoke pass.
SAAS_RENEWALS_ENABLED=false
# Independent server-only bearer token for POST /api/saas/renewals/process.
SAAS_RENEWAL_WORKER_SECRET=replace-with-an-independent-random-secret

# PDF/email worker: disabled until SQL, private storage and staging checks pass.
SAAS_DOCUMENTS_ENABLED=false
SAAS_DOCUMENT_WORKER_SECRET=replace-with-another-independent-random-secret
# Resend verified sender; configure both values together, server-only.
RESEND_API_KEY=replace-with-resend-api-key
SAAS_RECEIPT_FROM=Sport Admin <billing@your-verified-domain.example>

# Optional managed notification gateways. Configure endpoint and token together.
EMAIL_PROVIDER_ENDPOINT=https://notifications.example.com/deliver
EMAIL_PROVIDER_TOKEN=replace-with-provider-token
PUSH_PROVIDER_ENDPOINT=https://notifications.example.com/deliver
PUSH_PROVIDER_TOKEN=replace-with-provider-token
